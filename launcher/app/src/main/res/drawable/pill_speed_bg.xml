<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: the same white pill as the other top buttons, so the dark focused text stays readable. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- Only while a speed test runs (MainActivity.setSpeedPillDark): a dark scrim so the live figures stand out
         from the wallpaper. At rest the pill keeps the usual glass background, like the pills beside it. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#99000000" android:endColor="#73000000" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
