<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused: the same white pill as the other top buttons, so the dark focused text stays readable. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F5FFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
    <!-- The speed pill sits over a bright wallpaper, where a white scrim left the white figures hard to read.
         A dark scrim still lets the wallpaper through but keeps the numbers legible from the sofa. -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#99000000" android:endColor="#73000000" />
            <stroke android:width="1dp" android:color="#3DFFFFFF" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</selector>
