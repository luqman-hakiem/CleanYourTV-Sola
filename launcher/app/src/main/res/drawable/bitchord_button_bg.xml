<?xml version="1.0" encoding="utf-8"?>
<!-- BitChord control buttons: a saturated blue pill when the TV remote's focus lands on them,
     the same frosted glass as the other widgets at rest. Blue keeps the white player glyphs
     readable; a solid white focus pill made the emoji glyphs disappear. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF2B6FE0" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF1E56B8" />
            <stroke android:width="1.5dp" android:color="#FFFFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#24FFFFFF" android:endColor="#0AFFFFFF" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
